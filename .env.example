# Neon: Vercel добавляет их сам после подключения базы через Marketplace.
# Локально — скопировать из Vercel → Storage → база → .env.local в файл .env.local
DATABASE_URL=
# Прямое подключение без пулера — для миграций drizzle-kit
DATABASE_URL_UNPOOLED=

# Случайная строка не короче 32 символов
BETTER_AUTH_SECRET=

# Адрес сайта: http://localhost:3000 локально, https://<проект>.vercel.app на проде
BETTER_AUTH_URL=http://localhost:3000
