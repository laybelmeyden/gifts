# Строка подключения к Neon (Vercel добавит её сам после подключения Neon через Marketplace)
DATABASE_URL=

# Случайная строка не короче 32 символов: npx @better-auth/cli secret
BETTER_AUTH_SECRET=

# Адрес сайта: http://localhost:3000 локально, https://<проект>.vercel.app на проде
BETTER_AUTH_URL=http://localhost:3000
